{
  "name": "southbag-office",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "bun run db:migrate:local && playwright test",
    "db:migrate:local": "wrangler d1 migrations apply office --local",
    "db:migrate:remote": "wrangler d1 migrations apply office --remote",
    "cf:db:create": "wrangler d1 create office",
    "cf:deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260625.1",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^24.3.0",
    "@types/sanitize-html": "^2.16.1",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^3.2.4",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "jose": "^6.2.8",
    "sanitize-html": "^2.17.6"
  }
}
